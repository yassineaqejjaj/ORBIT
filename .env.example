# ORBIT — copy to `.env` (cp .env.example .env). Used by docker compose (api, worker) and by the
# backend when run on the host. In containers, the infrastructure URLs below are overridden by
# docker-compose.yml (service host names); when running on the host use the localhost variants.

# --- Runtime ------------------------------------------------------------------------------------
# development | production | test
ORBIT_ENV=development
ORBIT_LOG_LEVEL=INFO

# --- Infrastructure (ARCHITECTURE §1) ----------------------------------------------------------------
ORBIT_DATABASE_URL=postgresql+asyncpg://orbit:orbit@postgres:5432/orbit
# host: postgresql+asyncpg://orbit:orbit@localhost:5433/orbit
ORBIT_OPENSEARCH_URL=http://opensearch:9200
# host: http://localhost:9201
ORBIT_VALKEY_URL=redis://valkey:6379/0
# host: redis://localhost:6380/0
ORBIT_DATABASE_POOL_SIZE=10
ORBIT_DATABASE_MAX_OVERFLOW=10

# --- Security ------------------------------------------------------------------------------------------
# Required in production (>= 32 chars): openssl rand -hex 32
ORBIT_JWT_SECRET=orbit-dev-secret-change-me-0123456789abcdef
ORBIT_JWT_TTL_MINUTES=720
# true behind HTTPS
ORBIT_COOKIE_SECURE=false

# --- Bootstrap administrator (created at first start when the database has no user) --------------------
ORBIT_BOOTSTRAP_ADMIN_EMAIL=admin@orbit.local
ORBIT_BOOTSTRAP_ADMIN_PASSWORD=orbit-admin
ORBIT_BOOTSTRAP_ADMIN_NAME=Administrateur ORBIT

# --- Storage -------------------------------------------------------------------------------------------
ORBIT_OBJECT_STORE_PATH=/data/objects
ORBIT_MAX_UPLOAD_MB=50

# --- Retrieval models ------------------------------------------------------------------------------------
# fastembed | openai (TEI/vLLM/LiteLLM) | hash (tests)
ORBIT_EMBEDDING_PROVIDER=fastembed
ORBIT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# must match the model
ORBIT_EMBEDDING_DIM=384
ORBIT_EMBEDDING_BASE_URL=
ORBIT_EMBEDDING_API_KEY=
# defaults to FASTEMBED_CACHE_PATH (/opt/models in the image)
ORBIT_MODEL_CACHE_DIR=
# heuristic | fastembed (cross-encoder) | none
ORBIT_RERANKER=heuristic
ORBIT_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# candidates scored by the cross-encoder / characters per passage (latency: 20 x 800 ~ 370 ms on Apple M5)
ORBIT_RERANKER_TOP_N=20
ORBIT_RERANKER_MAX_CHARS=800
# build arg: bake the cross-encoder into the image (~470 MB, Apache-2.0, multilingual)
PRELOAD_RERANKER=true

# --- Optional LLM (OpenAI-compatible: vLLM, Ollama, LiteLLM…). Empty = deterministic mode. -------------
# e.g. http://ollama:11434/v1
ORBIT_LLM_BASE_URL=
ORBIT_LLM_MODEL=
ORBIT_LLM_API_KEY=
ORBIT_LLM_TIMEOUT_SECONDS=30

# --- AI security (docs/AI_CONTEXT_ENGINEERING.md §A) --------------------------------------------------------
# Prompt-injection detector at ingestion; chunks scoring >= threshold are quarantined (owner release).
ORBIT_INJECTION_DETECTION=true
ORBIT_INJECTION_THRESHOLD=0.6
# Optional local classifier on top of the rules: off | local (never an external call).
ORBIT_INJECTION_CLASSIFIER=off
# Spotlighting: served content wrapped as untrusted data (context, MCP, Ask).
ORBIT_SPOTLIGHTING=true
# Ranking penalty of low-trust sources (medium = half); 0 disables trust in ranking.
ORBIT_TRUST_RANKING_PENALTY=0.15
# Poisoning alert: N memory proposals/facts from one recent source or agent within the window (hours).
ORBIT_POISONING_ALERT_THRESHOLD=8
ORBIT_POISONING_WINDOW_HOURS=24

# --- Retrieval (docs/AI_CONTEXT_ENGINEERING.md §B) ---------------------------------------------------
# Contextual preamble per chunk: auto (LLM within the guardrail, else deterministic) | deterministic | off
ORBIT_CONTEXTUAL_RETRIEVAL=auto
ORBIT_CONTEXTUAL_LLM_MAX_CHUNKS=64
# chunks per progressive re-index job (existing projects without preamble, queued by the worker)
ORBIT_CONTEXTUAL_REINDEX_BATCH=200
# Query rewriting: auto (multi-query / decomposition / HyDE with the LLM, else synonyms + project entities) | deterministic (no LLM on the hot path) | off
ORBIT_QUERY_REWRITE=deterministic
ORBIT_QUERY_REWRITE_HYDE=true
ORBIT_QUERY_REWRITE_MAX_QUERIES=4
# Iterative retrieval: rounds (1-3) re-searching uncovered sub-topics
ORBIT_RETRIEVAL_MAX_ROUNDS=3
# Visual documents (PDF/PPTX images): auto (vision LLM within the guardrail, else OCR if installed, else alt text) | off
ORBIT_VISUAL_EXTRACTION=auto
ORBIT_VISUAL_LLM=true
ORBIT_VISUAL_MAX_IMAGES=20
ORBIT_VISUAL_MIN_SIZE=96

# --- Context assembly (docs/AI_CONTEXT_ENGINEERING.md §C) -------------------------------------------------
# Prompt-cache-aware layout (stable prefix first) + cache_prefix_hash; reuse window in seconds
ORBIT_CONTEXT_CACHE_ORDERING=true
ORBIT_CONTEXT_CACHE_TTL_SECONDS=300
# Progressive mode: tokens of each item's teaser in the summary index
ORBIT_CONTEXT_PROGRESSIVE_EXCERPT_TOKENS=40
# Per-agent-kind context profiles (Paramètres > Profils de contexte)
ORBIT_CONTEXT_PROFILES=true
# Sentence compression: learned (embeddings + redundancy + optional local pruner) | extractive
ORBIT_COMPRESSION_MODE=learned
# Optional local pruning model hook "package.module:function" (empty = none)
ORBIT_COMPRESSION_PRUNER=
# Context sufficiency score/verdict; thresholds sufficient / partial
ORBIT_CONTEXT_SUFFICIENCY=true
ORBIT_SUFFICIENCY_SUFFICIENT_THRESHOLD=0.75
ORBIT_SUFFICIENCY_PARTIAL_THRESHOLD=0.4
# "Demander à ORBIT" answers "je ne sais pas" when the context is insufficient
ORBIT_ASK_ABSTAIN_WHEN_INSUFFICIENT=true

# --- MCP connectors & MarkItDown (docs/FEATURES.md F6, docs/integrations/mcp-servers.md) ------------------
# Custom MCP servers (arbitrary command/URL) for platform admins only — keep false unless needed.
ORBIT_MCP_ALLOW_CUSTOM=false
# Timeout of one MCP call in seconds (the stdio server process is killed on timeout).
ORBIT_MCP_TIMEOUT_SECONDS=60
# Maximum items ingested per MCP synchronisation (the rest follows at the next sync).
ORBIT_MCP_MAX_ITEMS=500
# Fallback converter for pptx/xlsx/xls/msg/eml/epub/odt/rtf/images: auto (if markitdown-mcp is installed) | off
ORBIT_MARKITDOWN_MCP=auto

# --- Observability -----------------------------------------------------------------------------------------
# e.g. http://jaeger:4318 or Langfuse OTLP endpoint
ORBIT_OTLP_ENDPOINT=
# key=value,key2=value2
ORBIT_OTLP_HEADERS=
# indices {prefix}-chunks-v1 / {prefix}-memory-v1
ORBIT_INDEX_PREFIX=orbit
# EUR, cost estimate of served contexts
ORBIT_COST_PER_1K_TOKENS=0.002

# --- Worker ------------------------------------------------------------------------------------------------
ORBIT_WORKER_CONCURRENCY=2
ORBIT_WORKER_POLL_INTERVAL_SECONDS=1.0
ORBIT_WORKER_HEARTBEAT_SECONDS=30
ORBIT_WORKER_JOB_TIMEOUT_SECONDS=900
ORBIT_WORKER_STALE_LOCK_SECONDS=1800
ORBIT_WORKER_SHUTDOWN_GRACE_SECONDS=30
ORBIT_WORKER_MAINTENANCE_INTERVAL_SECONDS=300
# Prometheus endpoint of the worker (0 = disabled)
ORBIT_WORKER_METRICS_PORT=9464

# --- Postgres container ---------------------------------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit
