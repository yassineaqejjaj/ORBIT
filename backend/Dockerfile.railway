# syntax=docker/dockerfile:1.7
# ORBIT backend image for Railway (same as Dockerfile, minus BuildKit cache mounts and VOLUME,
# which Railway rejects; the object store is a Railway volume mounted on /data/objects).
#   docker build -t orbit-backend .
# The embedding model is downloaded at build time so the runtime works offline.

ARG PYTHON_VERSION=3.12

FROM ghcr.io/astral-sh/uv:0.12.17 AS uv

FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    FASTEMBED_CACHE_PATH=/opt/models \
    ORBIT_MODEL_CACHE_DIR=/opt/models \
    HF_HOME=/opt/models/hf

COPY --from=uv /uv /uvx /usr/local/bin/

RUN groupadd --system --gid 10001 orbit \
    && useradd --system --uid 10001 --gid orbit --home-dir /app --shell /usr/sbin/nologin orbit

WORKDIR /app

# 1. Dependencies (cached layer: only invalidated when pyproject/uv.lock change)
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project --python "$(which python3)"

# 1b. MCP servers (docs/FEATURES.md F6, docs/integrations/mcp-servers.md): Node.js (official binary,
#     pinned + SHA-256 checked) and the pinned stdio MCP servers, installed at build time so that the
#     runtime never downloads code. Presets call these binaries (allowlist); they run as `orbit`.
ARG NODE_VERSION=24.21.0
ARG MS365_MCP_VERSION=0.158.0
ARG SLACK_MCP_VERSION=1.3.0
ARG FIGMA_MCP_VERSION=0.13.2
ARG MCP_ATLASSIAN_VERSION=0.23.1
ARG WORKSPACE_MCP_VERSION=2.0.1
ARG MCP_OBSIDIAN_VERSION=0.2.3
ARG MARKITDOWN_MCP_VERSION=0.0.1a7
COPY --from=ghcr.io/github/github-mcp-server:v1.14.0 /server/github-mcp-server /usr/local/bin/github-mcp-server
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && case "$(dpkg --print-architecture)" in amd64) NODE_ARCH=x64 ;; arm64) NODE_ARCH=arm64 ;; *) exit 1 ;; esac \
    && NODE_TAR="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
    && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TAR}" \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" | grep " ${NODE_TAR}\$" | sha256sum -c - \
    && tar -xJf "${NODE_TAR}" -C /usr/local --strip-components=1 --no-same-owner \
        --exclude='*/README.md' --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/include' \
    && rm "${NODE_TAR}" \
    && npm install -g --omit=dev --no-fund --no-audit \
        "@softeria/ms-365-mcp-server@${MS365_MCP_VERSION}" "slack-mcp-server@${SLACK_MCP_VERSION}" \
        "figma-developer-mcp@${FIGMA_MCP_VERSION}" \
    && npm cache clean --force \
    && apt-get purge -y curl xz-utils && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* /root/.npm
ENV UV_TOOL_DIR=/opt/mcp-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin
RUN for tool in "mcp-atlassian==${MCP_ATLASSIAN_VERSION}" "workspace-mcp==${WORKSPACE_MCP_VERSION}" \
        "mcp-obsidian==${MCP_OBSIDIAN_VERSION}" "markitdown-mcp==${MARKITDOWN_MCP_VERSION}"; do \
        uv tool install --no-cache --python "$(which python3)" "$tool" || exit 1; \
    done \
    && chmod -R a+rX /opt/mcp-tools

# 2. Embedding model (and optionally the cross-encoder reranker) baked into the image
ARG ORBIT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARG PRELOAD_RERANKER=true
ARG ORBIT_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ENV ORBIT_EMBEDDING_MODEL=${ORBIT_EMBEDDING_MODEL}
COPY docker/preload_models.py /tmp/preload_models.py
RUN python /tmp/preload_models.py \
    && rm /tmp/preload_models.py \
    && chmod -R a+rX /opt/models

# 3. Application code
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY docker/entrypoint.sh /usr/local/bin/orbit-entrypoint
RUN chmod 0755 /usr/local/bin/orbit-entrypoint \
    && python -m compileall -q app \
    && mkdir -p /data/objects \
    && chown -R orbit:orbit /data /app

# Runtime is offline-capable: models are loaded from the baked cache.
ENV HF_HUB_OFFLINE=1 \
    ORBIT_OBJECT_STORE_PATH=/data/objects

USER orbit
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/orbit-entrypoint"]
CMD ["all"]
